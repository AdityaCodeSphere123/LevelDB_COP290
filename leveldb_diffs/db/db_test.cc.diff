+  // Pre-fill.
+  ASSERT_LEVELDB_OK(FillRandom(200));
+
+  for (int w = 0; w < kWriters; ++w) {
+    writers.emplace_back([&, w]() {
+      while (!start.load()) std::this_thread::yield();
+      WriteOptions wo;
+      for (int i = 0; i < kKeysPerWriter; ++i) {
